rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The whole site sits behind the team key: the `unlock` Cloud Function
    // verifies the key and mints a custom token, so "signed in" == "has the key".
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
